# ==============================================================================
# TechPulse AI — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the filled .env to Git.
# Add .env to your .gitignore if it is not already there.
# ==============================================================================


# ==============================================================================
# DATABASE — TiDB / MySQL
# ==============================================================================
# Writer (read/write) connection
DATABASE_WRITER_URL=jdbc:mysql://gateway01.us-east-1.prod.aws.tidbcloud.com:4000/techbite?useSSL=true&enabledTLSProtocols=TLSv1.2&serverTimezone=UTC&readOnlyPropagatesToServer=false
DATABASE_WRITER_USER=your_tidb_username
DATABASE_WRITER_PASSWORD=your_tidb_password

# Replica (read-only) connection — can be the same as writer if you have no replica
DATABASE_REPLICA_URL=${DATABASE_WRITER_URL}
DATABASE_REPLICA_USER=${DATABASE_WRITER_USER}
DATABASE_REPLICA_PASSWORD=${DATABASE_WRITER_PASSWORD}


# ==============================================================================
# REDIS
# ==============================================================================
# For local development: REDIS_HOST=localhost, REDIS_PORT=6379
# For Render / production: set SPRING_DATA_REDIS_HOST to your Render Redis hostname
SPRING_DATA_REDIS_HOST=your_redis_host
SPRING_DATA_REDIS_PORT=6379

# Full Redis URL (used by RedisConfig.java — typically redis://host:port)
REDIS_URL=redis://your_redis_host:6379


# ==============================================================================
# GEMINI AI (Google Generative Language API)
# ==============================================================================
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Optional: separate key for the Explain endpoint (falls back to GEMINI_API_KEY if not set)
GEMINI_EXPLAIN_API_KEY=${GEMINI_API_KEY}


# ==============================================================================
# FIREBASE (Authentication)
# ==============================================================================
# Paste the full contents of your Firebase service account JSON here, on a single line.
# Get it from Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# The JSON should look like: {"type":"service_account","project_id":"...","private_key":"..."}
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your_project_id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Alternative: path to your firebase credentials JSON file (used if FIREBASE_SERVICE_ACCOUNT_JSON is not set)
# FIREBASE_CREDENTIALS_PATH=/path/to/firebase-service-account.json


# ==============================================================================
# JWT (JSON Web Token)
# ==============================================================================
# Must be a long, random secret string (minimum 32 characters, ideally 64+).
# Generate one with: openssl rand -hex 32
JWT_SECRET=your_long_random_jwt_secret_at_least_64_characters_long_replace_this


# ==============================================================================
# ANDROID (Optional — for app link verification)
# ==============================================================================
# Your Android app's SHA-256 certificate fingerprint.
# Get it with: keytool -list -v -keystore your-keystore.jks
# Format: AA:BB:CC:...
ANDROID_SHA256_FINGERPRINT=71:BC:9C:71:07:82:E2:3C:F8:55:A2:33:16:F7:FA:4C:FF:18:E5:B0:08:AD:49:BC:60:09:47:43:1F:57:44:B3


# ==============================================================================
# SPRING PROFILE
# ==============================================================================
# Use "prod" for Render deployment, "dev" for local development
SPRING_PROFILES_ACTIVE=prod
