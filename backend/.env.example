# ==============================================================================
# TechPulse AI — Django backend environment template
# ==============================================================================
# Copy this file to `.env` and fill in the values:
#
#   cd backend
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS/Linux)
#
# `.env` is ignored by Git. Never commit real credentials.
#
# Variable names follow the old Java backend where the Django backend reads the
# same setting. Django-only settings and the Java replacements are noted inline.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. RUNTIME
# ------------------------------------------------------------------------------
PORT=8080
# The web container runs `migrate --fake-initial` and `collectstatic` on boot.
# Worker/beat containers force both to false in docker-compose.yml.
RUN_MIGRATIONS=true
COLLECT_STATIC=true
CELERY_WORKER_CONCURRENCY=2
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
WEB_APP_ORIGIN=http://localhost:3000
# TZ=UTC

# Java backend: spring.profiles.active, jwt.secret, jwt.expiration.
# - Django uses DJANGO_DEBUG instead of a Spring profile.
# - Django uses DJANGO_SECRET_KEY; JWT_SECRET is still accepted as a fallback.
# - JWT expiry is handled by Firebase tokens, so jwt.expiration is unused.
# JWT_SECRET=


# ------------------------------------------------------------------------------
# 2. DATABASE — TiDB / MySQL (same names as the Java backend)
# ------------------------------------------------------------------------------
# TiDB writer. `jdbc:mysql://` and `mysql://` URLs are accepted by config.db.
# Leave empty with DJANGO_DEBUG=true to use the local SQLite file instead.
DATABASE_WRITER_URL=jdbc:mysql://gateway01.us-east-1.prod.aws.tidbcloud.com:4000/techbite?useSSL=true&enabledTLSProtocols=TLSv1.2&serverTimezone=UTC&readOnlyPropagatesToServer=false
DATABASE_WRITER_USER=your_tidb_username
DATABASE_WRITER_PASSWORD=your_tidb_password
# Toggle this to override the local SQLite file used when no writer URL is set.
# SQLITE_PATH=

# Optional read replica. Leave blank to route reads to the writer.
DATABASE_REPLICA_URL=
DATABASE_REPLICA_USER=
DATABASE_REPLICA_PASSWORD=


# ------------------------------------------------------------------------------
# 3. REDIS — cache, Celery broker, rate limits, ingestion lock
# ------------------------------------------------------------------------------
# Java names SPRING_DATA_REDIS_HOST / SPRING_DATA_REDIS_PORT are still honoured.
# REDIS_HOST / REDIS_PORT take precedence when both are set.
REDIS_HOST=redis
REDIS_PORT=6379
# Full URL; when set it overrides REDIS_HOST/REDIS_PORT.
REDIS_URL=
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# Legacy aliases kept for deployments that still inject the Java names:
# SPRING_DATA_REDIS_HOST=redis
# SPRING_DATA_REDIS_PORT=6379


# ------------------------------------------------------------------------------
# 4. GEMINI AI (same names as the Java backend)
# ------------------------------------------------------------------------------
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
# Assistant/explain key; falls back to GEMINI_API_KEY when empty.
GEMINI_EXPLAIN_API_KEY=your_gemini_explain_api_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.6-flash


# ------------------------------------------------------------------------------
# 5. FIREBASE AUTH (same names as the Java backend)
# ------------------------------------------------------------------------------
# Paste the full service-account JSON on one line, or set a file path.
# Firebase Console -> Project Settings -> Service Accounts -> Generate New Key
FIREBASE_CREDENTIALS_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=


# ------------------------------------------------------------------------------
# 6. ANDROID APP LINKS (same name as the Java backend)
# ------------------------------------------------------------------------------
# Served by /.well-known/assetlinks.json for Android deep-link verification.
ANDROID_SHA256_FINGERPRINT=71:BC:9C:71:07:82:E2:3C:F8:55:A2:33:16:F7:FA:4C:FF:18:E5:B0:08:AD:49:BC:60:09:47:43:1F:57:44:B3


# ------------------------------------------------------------------------------
# 7. INGESTION, RATE LIMITS, TESTING
# ------------------------------------------------------------------------------
NEWS_INGESTION_ENABLED=true
NEWS_MAX_ARTICLES_PER_INGESTION=20
DISCOVERY_THREAD_POOL_SIZE=10
AI_RATE_LIMIT_PER_USER_PER_MINUTE=12
AI_RATE_LIMIT_PER_IP_PER_MINUTE=30
# Accepts `Authorization: Bearer test:<uid>` for local contract testing only.
ALLOW_TEST_AUTH=false
